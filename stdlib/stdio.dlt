#include <stdtypes>

fn std::printf(format: char*, ...) -> int;
fn std::fprintf(stream: void*, format: char*, ...) -> int;
fn std::sprintf(str: char*, format: char*, ...) -> int;
fn std::scanf(format: char*, ...) -> int;
fn std::fopen(filename: char*, mode: char*) -> void*;
fn std::fclose(stream: void*) -> int;
fn std::fread(ptr: void*, size: size_t, nmemb: size_t, stream: void*) -> size_t;
fn std::fwrite(ptr: void*, size: size_t, nmemb: size_t, stream: void*) -> size_t;
fn std::fseek(stream: void*, offset: size_t, whence: int) -> int;
fn std::ftell(stream: void*) -> int64;

fn std::execute(cmd: char*) -> int;