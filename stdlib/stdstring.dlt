#include <stdtypes>

fn std::strlen(s: char*) -> int64;
fn std::strcpy(dest: char*, src: char*) -> char*;
fn std::strncpy(dest: char*, src: char*, n: size_t) -> char*;
fn std::strcat(dest: char*, src: char*) -> char*;
fn std::strcmp(s1: char*, s2: char*) -> int;
fn std::strncmp(s1: char*, s2: char*, n: size_t) -> int;
fn std::strchr(s: char*, c: int) -> char*;
fn std::strstr(haystack: char*, needle: char*) -> char*;