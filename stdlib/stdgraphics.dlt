#include <stdbool>

fn std::openWindow(title: char*, width: int, height: int) -> int;

fn std::isWindowOpen(window: int) -> bool;
fn std::keepWindowOpen(window: int) -> void;
fn std::updateWindow(window: int) -> void;

fn std::setWindowTitle(window: int, title: char*) -> void;
fn std::setWindowSize(window: int, width: int, height: int) -> void;
fn std::getWindowSize(window: int, width: int*, height: int*) -> void;

fn std::destroyWindow(window: int) -> void;
fn std::closeWindow(window: int) -> void;
fn std::maximizeWindow(window: int) -> void;
fn std::minimizeWindow(window: int) -> void;

fn std::isKeyPressed(window: int, key: char) -> bool;

fn std::createOpenGLContext(window: int) -> bool;
fn std::makeContextCurrent(window: int) -> bool;
fn std::swapBuffers(window: int) -> void;