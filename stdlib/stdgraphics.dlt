#include <stdbool>

fn stdOpenWindow(title: char*, width: int, height: int) -> int;

fn stdIsWindowOpen(window: int) -> bool;
fn stdKeepWindowOpen(window: int) -> void;
fn stdUpdateWindow(window: int) -> void;

fn stdSetWindowTitle(window: int, title: char*) -> void;
fn stdSetWindowSize(window: int, width: int, height: int) -> void;
fn stdGetWindowSize(window: int, width: int*, height: int*) -> void;

fn stdDestroyWindow(window: int) -> void;
fn stdCloseWindow(window: int) -> void;
fn stdMaximizeWindow(window: int) -> void;
fn stdMinimizeWindow(window: int) -> void;

fn stdIsKeyPressed(window: int, key: char) -> bool;

fn stdCreateOpenGLContext(window: int) -> bool;
fn stdMakeContextCurrent(window: int) -> bool;
fn stdSwapBuffers(window: int) -> void;