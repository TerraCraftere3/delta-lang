#include <stdio>
#include <stdgraphics>
#include <stdtime>
#include <glew>

fn fibonacci(n: int) -> int64;

fn printFibonacci(n: int) -> void {
    let i: int = 0;
    while (i < n) {
        std::printf("Fibonacci #%d: %lld\n", i+1, fibonacci(i+1));
        i++;
    }
}

fn main() -> int {
    if(_WIN32){
        std::printf("Running on Windows\n");
    }else{
        std::printf("Not running on Windows\n");
    }
    std::printf("Compiler Name: %s\nCompiler Version: %s\nStandard Version: %s\n", _DLT_CC_NAME, _DLT_CC_VERSION, _DLT_VERSION);

    printFibonacci(30);

    let win: int = std::stdOpenWindow("Delta Demo", 800, 600);
    if (win < 0) {
        std::printf("Failed to create window\n");
        return 1;
    }

    if (std::stdCreateOpenGLContext(win) == 0) {
        std::printf("Failed to create OpenGL context\n");
        std::stdDestroyWindow(win);
        return 1;
    }

    // Make the context current
    if (std::stdMakeContextCurrent(win) == 0) {
        std::printf("Failed to make context current\n");
        std::stdDestroyWindow(win);
        return 1;
    }

    if (glewInit() > 0) {
        std::printf("Failed to initialize glew!\n");
        return 1;
    }

    while (std::stdIsWindowOpen(win)) {
        std::stdUpdateWindow(win);
        if (std::stdIsKeyPressed(win, 'Z')) {
            std::stdCloseWindow(win); // Close window when Z is pressed
        }

        let width: int = 0;
        let height: int = 0;
        std::stdGetWindowSize(win, &width, &height);

        glViewport(0, 0, width, height);
        glClearColor(1.0f, 0.8f, 0.2f, 1.0f);
        glClear(GL_COLOR_BUFFER_BIT);

        std::stdSwapBuffers(win);
        std::stdStdSleep(16); // sleep 16ms (~60fps)
    }

    std::stdDestroyWindow(win);
    return 0;
}
