fn fibonacci(n: int) -> int64 {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

fn sumToN(n: int) -> int64 {
    let i: int = 0;
    let acc: int64 = 0;
    while (i <= n) {
        acc = acc + i;
        i++;
    }
    return acc;
}

fn factorial(n: int) -> int64 {
    let i: int = 2;
    let result: int64 = 1;
    while (i <= n) {
        result = result * i;
        i++;
    }
    return result;
}

fn deadBranchExample(n: int) -> int64 {
    if (0) {
        return n * 9999;
    }
    return n + 42;
}
